# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Groq API for Whisper STT
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA API for Nemotron-3-Embed-1B
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Qdrant Vector Database
# Note: If no external Qdrant is running, it will automatically persist locally to ./qdrant_storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=edumind_course_transcripts
QDRANT_STORAGE_PATH=./qdrant_storage

# LLM Configuration for LangGraph Agent
# Options: "gemini" (recommended) | "groq" | "nvidia"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.8-flash
GROQ_LLM_MODEL=qwen/qwen3.8-27b
NVIDIA_LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TEMPERATURE=0.3
SIMILARITY_THRESHOLD=0.20

# MongoDB Connection (for transcript block persistence & fallback)
MONGODB_URI=mongodb://localhost:27017/edumind-ai

# Node.js Backend URL (for callbacks/webhooks)
BACKEND_URL=http://localhost:5001
